{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "test": {},
    "openapi": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "../../packages/client/openapi.json"
      ]
    }
  }
}
